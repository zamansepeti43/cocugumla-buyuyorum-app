/* =====================================================
   PREMIUM SHARED HEADER — FINAL
   ===================================================== */

html body #root .app-shell,
html body #root .app-shell-worlds {
  position: relative !important;
  background: transparent !important;
}

/* Header artýk sayfanýn ayrý bölümü deðil */
html body #root .app-shell .topbar,
html body #root .app-shell-worlds .topbar {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  width: 100% !important;
  height: 76px !important;
  min-height: 76px !important;
  z-index: 99999 !important;

  display: grid !important;
  grid-template-columns: auto 1fr auto !important;
  align-items: center !important;

  padding: 0 clamp(18px, 3vw, 42px) !important;

  background: linear-gradient(
    180deg,
    rgba(3,7,18,.72) 0%,
    rgba(3,7,18,.38) 58%,
    rgba(3,7,18,0) 100%
  ) !important;

  border: 0 !important;
  box-shadow: none !important;

  backdrop-filter: blur(7px) saturate(115%) !important;
  -webkit-backdrop-filter: blur(7px) saturate(115%) !important;
}

/* Logo */
html body #root .topbar .brand,
html body #root .topbar .reference-brand {
  position: relative !important;
  z-index: 2 !important;
}

/* Menü — kutu yok */
html body #root .topbar .desktop-nav {
  display: flex !important;
  justify-self: center !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 2px !important;

  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
  padding: 0 !important;
}

/* Premium yazýlar */
html body #root .topbar .desktop-nav a {
  min-height: 38px !important;
  padding: 0 14px !important;

  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 6px !important;

  border-radius: 9px !important;
  border: 1px solid transparent !important;

  background: transparent !important;
  box-shadow: none !important;

  color: rgba(255,255,255,.78) !important;

  font-family:
    Inter,
    DM Sans,
    ui-sans-serif,
    system-ui,
    -apple-system,
    "Segoe UI",
    sans-serif !important;

  font-size: 12px !important;
  line-height: 1 !important;
  font-weight: 700 !important;
  letter-spacing: .1px !important;

  text-shadow: 0 1px 8px rgba(0,0,0,.65) !important;

  transition:
    color .18s ease,
    background .18s ease,
    border-color .18s ease !important;
}

/* Hover */
html body #root .topbar .desktop-nav a:hover {
  color: #fff !important;
  background: rgba(255,255,255,.055) !important;
  border-color: rgba(255,255,255,.10) !important;
}

/* Aktif sayfa */
html body #root .topbar .desktop-nav a.active {
  color: #ffd45a !important;

  background: rgba(255,196,64,.08) !important;

  border: 1px solid rgba(255,205,80,.30) !important;

  box-shadow:
    inset 0 0 12px rgba(255,190,50,.045),
    0 0 14px rgba(255,190,50,.05) !important;
}

/* Menü ikonlarý */
html body #root .topbar .desktop-nav svg {
  width: 14px !important;
  height: 14px !important;
  stroke-width: 1.8 !important;
}

/* Profil alaný */
html body #root .topbar .child-chip {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

/* Profil yazýlarý */
html body #root .topbar .child-chip strong {
  color: rgba(255,255,255,.92) !important;
  font-size: 11px !important;
}

html body #root .topbar .child-chip small {
  color: rgba(255,255,255,.55) !important;
  font-size: 8px !important;
}

/* Profil yuvarlaðý */
html body #root .topbar .child-chip > span {
  width: 36px !important;
  height: 36px !important;
  border: 1px solid rgba(255,255,255,.35) !important;
  box-shadow: 0 4px 14px rgba(0,0,0,.35) !important;
}

/* Ana sayfanýn içeriði header'ýn altýndan baþlasýn */
html body #root .app-shell .main-content {
  position: relative !important;
  z-index: 1 !important;
}

/* Keþfet haritasý header'ýn arkasýndan baþlasýn */
html body #root .app-shell-worlds .worlds-map {
  position: relative !important;
  z-index: 1 !important;
}

/* Eski keþfet sol menüsü yok */
html body #root .app-shell-worlds .side-nav,
html body #root .app-shell-worlds .sidebar,
html body #root .app-shell-worlds .left-nav,
html body #root .app-shell-worlds .bottom-nav {
  display: none !important;
}

/* Keþfet geri butonu */
html body #root .app-shell-worlds .worlds-back {
  z-index: 100000 !important;
}

/* Alt navigasyon yok */
html body #root .bottom-nav {
  display: none !important;
}

/* =====================================================
   HOME — HEADER HERO ÝLE TEK PARÇA
   ===================================================== */

html body #root .home-page,
html body #root .reference-home-page {
  position: relative !important;
  background: #050711 !important;
}

/* Hero header'ýn arkasýna kadar çýksýn */
html body #root .reference-home-hero {
  margin-top: 0 !important;
}

/* Mobil */
@media (max-width: 760px) {
  html body #root .app-shell .topbar,
  html body #root .app-shell-worlds .topbar {
    height: 64px !important;
    min-height: 64px !important;
    padding: 0 12px !important;
  }

  html body #root .topbar .desktop-nav {
    gap: 0 !important;
  }

  html body #root .topbar .desktop-nav a {
    padding: 0 8px !important;
    font-size: 10px !important;
  }

  html body #root .topbar .desktop-nav svg {
    display: none !important;
  }

  html body #root .topbar .child-chip strong,
  html body #root .topbar .child-chip small {
    display: none !important;
  }
}

/* =========================================================
   DÜNYA İÇİ — PREMIUM TEK EKRAN TASARIM
   ========================================================= */

:root {
  --world-detail-header-height: 70px;
}

.app-shell-worlds {
  height: 100dvh !important;
  min-height: 100dvh !important;
  overflow: hidden !important;
}

.app-shell-worlds .main-content,
.app-shell-worlds .worlds-main-content {
  height: calc(100dvh - var(--world-detail-header-height)) !important;
  min-height: 0 !important;
  overflow: hidden !important;
}

/* =========================================================
   ANA KAPSAYICI
   ========================================================= */

.world-detail-page {
  position: relative;

  width: 100%;
  height: calc(100dvh - var(--world-detail-header-height));
  min-height: 0;
  max-height: calc(100dvh - var(--world-detail-header-height));

  display: flex;
  flex-direction: column;

  overflow: hidden;

  color: #fff;

  background:
    radial-gradient(
      circle at 78% 16%,
      var(--world-soft),
      transparent 34%
    ),
    linear-gradient(
      135deg,
      #070b17 0%,
      #080d1a 50%,
      #070a14 100%
    );
}

/* =========================================================
   GERİ DÖN
   ========================================================= */

.world-detail-back {
  position: absolute;
  top: 20px;
  left: 42px;

  z-index: 30;

  display: inline-flex;
  align-items: center;
  gap: 8px;

  padding: 10px 15px;

  border: 1px solid rgba(255,255,255,.12);
  border-radius: 14px;

  background: rgba(17,23,37,.82);

  color: rgba(255,255,255,.82);

  text-decoration: none;

  font-size: 13px;
  font-weight: 800;

  backdrop-filter: blur(12px);

  transition: .2s ease;
}

.world-detail-back:hover {
  color: #fff;
  background: rgba(255,255,255,.10);
  transform: translateX(-2px);
}

/* =========================================================
   HERO
   ========================================================= */

.world-detail-hero {
  position: relative;

  flex: 0 0 39%;
  height: 39%;
  min-height: 0;

  box-sizing: border-box;

  display: flex;
  align-items: center;

  padding:
    52px
    clamp(42px, 5vw, 76px)
    22px;

  overflow: hidden;

  border-bottom: 1px solid rgba(255,255,255,.08);

  background:
    radial-gradient(
      circle at 80% 50%,
      var(--world-soft),
      transparent 32%
    );
}

/* =========================================================
   HERO GLOW
   ========================================================= */

.world-detail-hero-glow {
  position: absolute;

  width: 420px;
  height: 420px;

  right: 7%;
  top: 50%;

  transform: translateY(-50%);

  border-radius: 50%;

  background: var(--world-soft);

  filter: blur(85px);

  pointer-events: none;
}

/* =========================================================
   HERO İÇERİK
   ========================================================= */

.world-detail-hero-content {
  position: relative;
  z-index: 5;

  width: min(620px, 60%);
}

.world-detail-kicker {
  display: flex;
  align-items: center;
  gap: 8px;

  margin-bottom: 7px;

  color: var(--world-accent);

  font-size: 12px;
  font-weight: 900;

  letter-spacing: .16em;
}

.world-detail-kicker span:first-child {
  font-size: 17px;
}

.world-detail-hero-content h1 {
  margin: 0 0 7px;

  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(44px, 5vw, 66px);
  line-height: .95;

  color: #fff;
}

.world-detail-hero-content > p {
  margin: 0 0 16px;

  max-width: 520px;

  color: rgba(255,255,255,.66);

  font-size: 15px;
  line-height: 1.4;
}

/* =========================================================
   PROGRESS
   ========================================================= */

.world-detail-progress {
  width: min(560px, 100%);

  box-sizing: border-box;

  padding: 12px 17px;

  border: 1px solid rgba(255,255,255,.10);
  border-radius: 16px;

  background: rgba(18,24,38,.82);

  box-shadow:
    0 12px 30px rgba(0,0,0,.22),
    inset 0 1px rgba(255,255,255,.035);

  backdrop-filter: blur(14px);
}

.world-detail-progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 7px;

  color: rgba(255,255,255,.65);

  font-size: 12px;
  font-weight: 800;
}

.world-detail-progress-top strong {
  color: var(--world-accent);
  font-size: 18px;
}

.world-detail-progress-track {
  width: 100%;
  height: 6px;

  overflow: hidden;

  border-radius: 99px;

  background: rgba(255,255,255,.08);
}

.world-detail-progress-track span {
  display: block;

  width: 0;
  height: 100%;

  border-radius: inherit;

  background: var(--world-accent);

  box-shadow: 0 0 14px var(--world-accent);

  transition: width .4s ease;
}

.world-detail-progress-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-top: 7px;

  color: rgba(255,255,255,.48);

  font-size: 11px;
}

.world-detail-progress-bottom span:last-child {
  display: flex;
  align-items: center;
  gap: 4px;
}

/* =========================================================
   SAĞDAKİ DÜNYA İKONU
   ========================================================= */

.world-detail-hero-orb {
  position: absolute;

  right: clamp(55px, 10vw, 150px);
  top: 50%;

  width: clamp(155px, 17vw, 230px);
  aspect-ratio: 1;

  transform: translateY(-50%);

  display: grid;
  place-items: center;

  border: 1px solid rgba(255,255,255,.13);
  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      var(--world-soft),
      rgba(255,255,255,.025) 70%
    );

  box-shadow:
    0 0 70px var(--world-soft),
    inset 0 0 40px rgba(255,255,255,.04);
}

.world-detail-hero-orb span {
  font-size: clamp(65px, 7vw, 100px);

  filter: drop-shadow(
    0 12px 22px rgba(0,0,0,.42)
  );

  animation: world-detail-float 4s ease-in-out infinite;
}

@keyframes world-detail-float {
  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-9px);
  }
}

/* =========================================================
   ALT ALAN
   ========================================================= */

.world-detail-content {
  flex: 1 1 auto;

  min-height: 0;

  box-sizing: border-box;

  padding:
    18px
    clamp(28px, 3.2vw, 52px)
    22px;

  display: flex;
  flex-direction: column;

  overflow: hidden;
}

/* =========================================================
   ALT BAŞLIK
   ========================================================= */

.world-detail-section-heading {
  flex: 0 0 auto;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  margin-bottom: 13px;
}

.world-detail-eyebrow {
  display: block;

  margin-bottom: 4px;

  color: var(--world-accent);

  font-size: 10px;
  font-weight: 900;

  letter-spacing: .16em;
}

.world-detail-section-heading h2 {
  margin: 0;

  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(28px, 2.8vw, 40px);
  line-height: 1;

  color: #fff;
}

.world-detail-section-heading p {
  margin: 5px 0 0;

  color: rgba(255,255,255,.52);

  font-size: 12px;
}

.world-detail-count {
  display: flex;
  align-items: center;
  gap: 6px;

  padding: 8px 13px;

  border: 1px solid rgba(255,255,255,.10);
  border-radius: 999px;

  background: rgba(255,255,255,.035);

  color: rgba(255,255,255,.68);

  font-size: 11px;
  font-weight: 800;
}

/* =========================================================
   KART GRID
   ========================================================= */

.world-section-grid {
  flex: 1 1 auto;

  min-height: 0;

  display: grid;

  gap: 13px;

  overflow: hidden;
}

/*
   3 bölüm varsa 3 kart yan yana.
   4 bölüm varsa 4 kart yan yana.
   5+ bölümde 4 kolon.
*/

.world-section-count-1 {
  grid-template-columns: minmax(250px, 420px);
}

.world-section-count-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.world-section-count-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.world-section-count-4,
.world-section-count-5 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

/* =========================================================
   ASIL KART
   ========================================================= */

.world-section-premium-card {
  position: relative;

  min-width: 0;
  min-height: 0;

  height: 100%;

  display: grid;

  grid-template-rows: 47% 53%;

  overflow: hidden;

  box-sizing: border-box;

  border: 1px solid rgba(255,255,255,.11);
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      rgba(30,36,57,.98),
      rgba(11,16,27,.99)
    );

  color: #fff;

  text-decoration: none;

  box-shadow:
    0 14px 32px rgba(0,0,0,.25),
    inset 0 1px rgba(255,255,255,.035);

  transition:
    transform .2s ease,
    border-color .2s ease,
    box-shadow .2s ease;
}

.world-section-premium-card:hover {
  transform: translateY(-4px);

  border-color: var(--world-accent);

  box-shadow:
    0 18px 38px rgba(0,0,0,.32),
    0 0 24px var(--world-soft);
}

/* =========================================================
   KART GÖRSEL ALANI
   ========================================================= */

.world-section-card-art {
  position: relative;

  min-height: 0;

  overflow: hidden;

  display: grid;
  place-items: center;

  border-bottom: 1px solid rgba(255,255,255,.07);

  background:
    radial-gradient(
      circle at 50% 45%,
      var(--world-soft),
      transparent 64%
    ),
    linear-gradient(
      145deg,
      rgba(40,48,78,.95),
      rgba(17,23,39,.98)
    );
}

.world-section-art-glow {
  position: absolute;

  width: 130px;
  height: 130px;

  border-radius: 50%;

  background: var(--world-soft);

  filter: blur(25px);
}

.world-section-card-icon {
  position: relative;
  z-index: 2;

  font-size: clamp(58px, 7vw, 94px);

  filter: drop-shadow(
    0 12px 18px rgba(0,0,0,.4)
  );

  transform: translateY(2px);
}

/* =========================================================
   NUMARA
   ========================================================= */

.world-section-card-number {
  position: absolute;

  top: 12px;
  left: 14px;

  z-index: 5;

  color: rgba(255,255,255,.58);

  font-size: 11px;
  font-weight: 900;

  letter-spacing: .08em;
}

/* =========================================================
   KİLİT
   ========================================================= */

.world-section-lock {
  position: absolute;

  right: 13px;
  top: 11px;

  z-index: 5;

  width: 30px;
  height: 30px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: rgba(0,0,0,.28);

  color: rgba(255,255,255,.72);
}

/* =========================================================
   KART METİN ALANI
   ========================================================= */

.world-section-card-body {
  min-width: 0;
  min-height: 0;

  box-sizing: border-box;

  padding: 13px 16px 12px;

  display: flex;
  flex-direction: column;

  overflow: hidden;
}

.world-section-card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-bottom: 6px;

  color: rgba(255,255,255,.40);

  font-size: 9px;
  font-weight: 900;

  letter-spacing: .11em;
}

.world-section-stars {
  display: flex;
  align-items: center;
  gap: 3px;

  color: #f5cf4a;

  letter-spacing: 0;
}

.world-section-card-body h3 {
  margin: 0 0 5px;

  color: #fff;

  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(18px, 1.8vw, 26px);
  line-height: 1.05;
}

.world-section-card-body p {
  margin: 0;

  color: rgba(255,255,255,.53);

  font-size: 11px;
  line-height: 1.4;

  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;

  overflow: hidden;
}

.world-section-card-footer {
  margin-top: auto;

  padding-top: 8px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  color: var(--world-accent);

  font-size: 10px;
  font-weight: 900;
}

.world-section-card-footer svg {
  flex: 0 0 auto;
}

/* =========================================================
   KİLİTLİ
   ========================================================= */

.world-section-premium-card.is-locked {
  opacity: .55;
  filter: saturate(.65);
}

.world-section-premium-card.is-locked:hover {
  transform: none;
  border-color: rgba(255,255,255,.11);
  box-shadow:
    0 14px 32px rgba(0,0,0,.25),
    inset 0 1px rgba(255,255,255,.035);
}

/* =========================================================
   BOŞ
   ========================================================= */

.world-detail-empty {
  flex: 1;

  display: grid;
  place-items: center;

  color: rgba(255,255,255,.65);
}

/* =========================================================
   1366 / 1080P
   ========================================================= */

@media (max-width: 1400px) {
  .world-detail-hero {
    flex-basis: 38%;
    height: 38%;

    padding-left: 4.5%;
    padding-right: 4.5%;
  }

  .world-detail-content {
    padding-top: 15px;
    padding-bottom: 17px;
  }

  .world-section-grid {
    gap: 11px;
  }

  .world-section-card-body {
    padding: 11px 13px;
  }
}

/* =========================================================
   DAR DESKTOP
   ========================================================= */

@media (max-width: 1050px) {
  .world-detail-hero-orb {
    right: 4%;
    transform: translateY(-50%) scale(.78);
  }

  .world-detail-hero-content {
    width: 66%;
  }

  .world-section-count-4,
  .world-section-count-5 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* =========================================================
   MOBİL
   ========================================================= */

@media (max-width: 700px) {
  .app-shell-worlds .main-content {
    overflow: auto !important;
  }

  .world-detail-page {
    height: auto;
    max-height: none;
    min-height: calc(100dvh - 70px);

    overflow: visible;
  }

  .world-detail-hero {
    height: auto;
    min-height: 430px;

    flex: none;

    padding: 75px 22px 24px;
  }

  .world-detail-hero-content {
    width: 100%;
  }

  .world-detail-hero-orb {
    display: none;
  }

  .world-detail-content {
    overflow: visible;

    padding: 20px 16px 30px;
  }

  .world-detail-section-heading {
    align-items: flex-start;
  }

  .world-detail-count {
    display: none;
  }

  .world-section-grid,
  .world-section-count-1,
  .world-section-count-2,
  .world-section-count-3,
  .world-section-count-4,
  .world-section-count-5 {
    grid-template-columns: 1fr;
    overflow: visible;
  }

  .world-section-premium-card {
    min-height: 270px;
  }

  .world-detail-back {
    left: 18px;
  }
}

